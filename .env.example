# ─── Database (MySQL) ─────────────────────────────────────────────
# Get your MySQL credentials from Hostinger: Databases → MySQL Databases
# Format: mysql://USERNAME:PASSWORD@HOST:PORT/DATABASE_NAME
DATABASE_URL="mysql://u1234567:password@mysql.hostinger.com:3306/u1234567_urbansafai"

# ─── NextAuth (Admin Login) ────────────────────────────────────────────
# Generate with: openssl rand -base64 32
NEXTAUTH_SECRET=your-secret-here
NEXTAUTH_URL=https://urbansafai.in

# ─── Admin Credentials ─────────────────────────────────────────────────
ADMIN_EMAIL=admin@urbansafai.in
ADMIN_PASSWORD=change-this-password

# ─── Email (Resend) ────────────────────────────────────────────────────
# Get yours at https://resend.com
# Optional — bookings still work without this, emails just won't send
RESEND_API_KEY=re_your-key-here
