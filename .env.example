# ═══════════════════════════════════════════════════════════════════
# UrbanSafai — Environment Variables
# ═══════════════════════════════════════════════════════════════════
# Copy this file as .env and fill in the values.
# On Hostinger / Supabase: set these in the Environment Variables panel.
#
# FIRST-TIME DEPLOYMENT STEPS:
# 1. Create a Supabase project at https://supabase.com
# 2. Get your connection string from Project Settings > Database
# 3. Set all variables below
# 4. Deploy / restart the app
# 5. Visit https://urbansafai.in/api/setup  (creates database tables)
# 6. Visit https://urbansafai.in/api/health  (verify everything is set)
# ═══════════════════════════════════════════════════════════════════

# ─── Database (Supabase / PostgreSQL) ─────────────────────────────────
# Get these from: Supabase Dashboard > Project Settings > Database
# Use the "Connection pooling" URI (transaction mode) for DATABASE_URL
# Use the "Direct connection" URI for DIRECT_URL (needed for migrations/setup)
DATABASE_URL="postgresql://postgres.[project-ref]:[password]@aws-0-[region].pooler.supabase.com:6543/postgres?pgbouncer=true"
DIRECT_URL="postgresql://postgres.[project-ref]:[password]@aws-0-[region].supabase.com:5432/postgres"

# ─── NextAuth (Admin Login) ────────────────────────────────────────────
NEXTAUTH_SECRET=0FDZf1PkSGP0LYznANgnJO8+NXtSVuMBHa8PRJ2bp7s=
NEXTAUTH_URL=https://urbansafai.in

# ─── Admin Credentials ─────────────────────────────────────────────────
ADMIN_EMAIL=admin@urbansafai.in
ADMIN_PASSWORD=UrbanSafai@2025

# ─── Email (Resend) ────────────────────────────────────────────────────
# Get your key at https://resend.com/api-keys
# Sends booking notification to admin + confirmation to customer
RESEND_API_KEY=re_your-resend-api-key-here

# ─── Server (optional, defaults shown) ─────────────────────────────────
# PORT=3000
# HOSTNAME=0.0.0.0
